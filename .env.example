# ============================================================================
# AICTE COMPLAINT INTELLIGENCE HUB — ENVIRONMENT CONFIGURATION EXAMPLE
# Proposed SIH Prototype — Demonstration & Production Configuration
# ============================================================================

# Application Runtime
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# Data Persistence Backend Mode
# Options: "local_persistent" (default SQL-equivalent transactional JSON store) | "supabase"
DATA_BACKEND_MODE="local_persistent"

# Optional Supabase / PostgreSQL Configuration (for hosted production deployment)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aicte_complaint_hub"

# Optional External AI Service (Server-Side Only — Never Exposed to Browser)
# If omitted or placeholder, deterministic Rule-Based Assistance runs automatically.
GEMINI_API_KEY=""
AI_MODEL_NAME="gemini-2.5-flash"

# Optional Email Notification Service (Server-Side Only)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_FROM="no-reply@example.edu.in"

